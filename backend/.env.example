# MediKiosk Backend Configuration Template
PORT=5000
NODE_ENV=development

# AI Provider (Groq required for conversational intake and structured summary)
GROQ_API_KEY=your_groq_api_key_here
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b

# Document Upload & OCR Configuration
MAX_DOCUMENT_SIZE_MB=10

# CORS Configuration (comma-separated origins or single frontend origin)
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Path (default: medikiosk.db relative to backend, or absolute path e.g. /data/medikiosk.db)
DATABASE_PATH=medikiosk.db

